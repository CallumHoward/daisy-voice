# Required - The ID of your Sanity project
PUBLIC_SANITY_PROJECT_ID=""
# Required - The Sanity dataset name, for example "production"
PUBLIC_SANITY_DATASET=""
# Required - A Sanity Viewer token, used for server-side queries and draft previews
SANITY_API_READ_TOKEN=""
# Optional - The Sanity API version to use
PUBLIC_SANITY_API_VERSION=""
# Optional - The URL of your Sanity Studio (defaults to http://localhost:3333)
PUBLIC_SANITY_STUDIO_URL=""

# Required - Resend API key for the contact form
RESEND_API_KEY=""
# Required - Verified sender address used by Resend
EMAIL_FROM=""
# Required - Recipient address for contact form submissions
EMAIL_TO=""

# Optional - Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX); analytics disabled if unset
PUBLIC_GA_MEASUREMENT_ID=
